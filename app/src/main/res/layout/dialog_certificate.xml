<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="842dp"
    android:layout_height="595dp"
    android:background="@drawable/bg_certificate"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingHorizontal="64dp"
    android:paddingVertical="44dp"
    tools:ignore="SpUsage,HardcodedText">

    <!-- Logo -->
    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:contentDescription="@null"
        android:src="@drawable/logo_brainquest" />

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:letterSpacing="0.12"
        android:text="CERTIFICATE OF ACHIEVEMENT"
        android:textColor="@color/primary"
        android:textSize="32dp"
        android:textStyle="bold" />

    <!-- Gold line -->
    <View
        android:layout_width="140dp"
        android:layout_height="3dp"
        android:layout_marginTop="8dp"
        android:background="@color/accent" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="This certificate is proudly presented to"
        android:textColor="@color/text_secondary"
        android:textSize="16dp" />

    <!-- Student name -->
    <TextView
        android:id="@+id/textCertName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/text_primary"
        android:textSize="44dp"
        android:textStyle="bold|italic"
        tools:text="Keisha Nalani" />

    <!-- School -->
    <TextView
        android:id="@+id/textCertSchool"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/text_secondary"
        android:textSize="16dp"
        tools:text="Year 10 • XMUM" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="for successfully mastering all 12 Cambridge IGCSE subjects in BrainQuest."
        android:textColor="@color/text_primary"
        android:textSize="17dp" />

    <!-- Details -->
    <TextView
        android:id="@+id/textCertDetails"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="@color/accent"
        android:textSize="16dp"
        android:textStyle="bold"
        tools:text="Level 22 Master • 4218 points • ★ 32" />

    <!-- Date, badge and signature -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="bottom"
        android:orientation="horizontal">

        <!-- Date -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textCertDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="15dp"
                tools:text="17 November 2026" />

            <View
                android:layout_width="180dp"
                android:layout_height="1dp"
                android:layout_marginTop="4dp"
                android:background="@color/text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Date awarded"
                android:textColor="@color/text_secondary"
                android:textSize="12dp" />
        </LinearLayout>

        <!-- Champion badge -->
        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:contentDescription="@null"
            android:src="@drawable/badge_champion" />

        <!-- Signature -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BrainQuest"
                android:textColor="@color/primary"
                android:textSize="20dp"
                android:textStyle="bold|italic" />

            <View
                android:layout_width="180dp"
                android:layout_height="1dp"
                android:layout_marginTop="4dp"
                android:background="@color/text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="BrainQuest Learning Team"
                android:textColor="@color/text_secondary"
                android:textSize="12dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
