<?xml version="1.0" encoding="utf-8"?>
<!-- Certificate border -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFDF5" />
            <stroke android:width="14dp" android:color="@color/accent" />
        </shape>
    </item>
    <item android:bottom="24dp" android:left="24dp" android:right="24dp" android:top="24dp">
        <shape android:shape="rectangle">
            <stroke android:width="2dp" android:color="@color/primary" android:dashGap="5dp" android:dashWidth="10dp" />
        </shape>
    </item>
</layer-list>
